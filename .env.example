# ─────────────────────────────────────────────────────────────
# OPTIONAL — only used when the visitor has NOT supplied their own key
# ─────────────────────────────────────────────────────────────
# Google AI Studio free-tier key: https://aistudio.google.com/app/apikey
# If omitted, the /api/chat route returns a 401 and the client stays in
# Simulated Demo Mode. This is the recommended default for sharing with
# prospects — their BYOK key takes precedence and never touches this value.
GEMINI_API_KEY=

# Model selection — change without redeploying code
GEMINI_MODEL=gemini-2.5-flash
# Fallback when the primary model returns a 429 or 404
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────
# Public site URL (used for metadata / share links)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000